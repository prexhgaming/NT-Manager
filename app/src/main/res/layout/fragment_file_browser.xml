<?xml version="1.0" encoding="utf-8"?>
<!--
  Dual panel host. The fragment creates two independent FilePanelView instances
  (left + right) that share the same public API.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <bin.nt.plus.ui.FilePanelView
        android:id="@+id/panel_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <View
        android:id="@+id/pane_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider_color" />

    <bin.nt.plus.ui.FilePanelView
        android:id="@+id/panel_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</LinearLayout>
