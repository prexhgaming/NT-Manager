<?xml version="1.0" encoding="utf-8"?>
<!-- Root layout: ConstraintLayout hosting the app bar, the dual-pane fragment and the bottom nav. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/app_bar_background"
        app:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/app_bar_background"
            app:navigationContentDescription="@string/cd_navigation"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/app_bar_title"
            app:subtitle="@string/loading"
            app:subtitleTextAppearance="@style/TextAppearance.NTManager.ToolbarSubtitle"
            app:subtitleTextColor="@color/app_bar_subtitle"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.NTManager.ToolbarTitle"
            app:titleTextColor="@color/app_bar_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/panes_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bottom_nav_background"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_tint"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_actions" />
</androidx.constraintlayout.widget.ConstraintLayout>
