<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 base theme, dark-mode aware. -->
    <style name="Theme.NTManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>

    <style name="TextAppearance.NTManager.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.NTManager.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
    </style>
</resources>
